{
	"name": "TX Humble New Tab Page",
	"short_name": "TX HNTP",
	"version": "2.3.0",
	"manifest_version": 3,
	"browser_specific_settings": {
		"gecko": {
			"id": "tx-hntp@txnewtabpage",
			"strict_min_version": "115.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"description": "Redesigned new tab page featuring your bookmarks, most visited, and recently closed in a custom layout.",
	"icons": {
		"128": "icons/icon_128.png",
		"48": "icons/icon_48.png",
		"16": "icons/icon_16.png"
	},
	"permissions": [
		"bookmarks",
		"topSites",
		"tabs",
		"sessions"
	],
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"chrome_settings_overrides": {
		"homepage": "newtab.html"
	},
	"options_ui": {
		"page": "newtab.html?options",
		"open_in_tab": true
	}
}
